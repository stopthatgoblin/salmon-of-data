{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salmon-electricity-scheduler",
  "main": "workers/electricity-scheduler.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "vars": { "ELECTRICITY_ROI_ENABLED": "false" },
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "ELECTRICITY_DATA",
      "id": "01af7cb09c1c4828b3023de16af4362b"
    }
  ],
  // The handler selects 07:00 UK time from the two UTC daily candidates.
  "triggers": { "crons": ["2,17,32,47 * * * *", "0 6,7 * * *", "5 7-12 * * *"] }
}
