{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salmon-electricity-preview",
  "main": "workers/electricity.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "vars": { "ELECTRICITY_PREVIEW": "true" },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": ["/api/electricity/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "ELECTRICITY_DATA", "id": "dacea186fcb3499a9e25d148173289ba" }
  ]
}
